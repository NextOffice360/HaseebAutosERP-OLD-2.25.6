# ---- dependencies / caches (ye machine-specific hain, repo mein nahi jate) ----
node_modules/
__pycache__/
*.pyc
.cache/
.npm/
.local/
.venv/
venv/

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- secrets (kabhi commit na hon) ----
.env
.env.*
*credentials*.json
*service-account*.json
.netrc
.git-credentials

# ---- git bundles (download artefact hain, repo ka hissa nahi) ----
*.bundle

# ---- scratch (verification logs rehte hain, magar probes/junk nahi) ----
tmp/probe_*.js
tmp/dbg*.js

# v2.30.4 — future ZIPs git me track na hon (.git 54MB history se bara hai);
# zip workspace tree me banti hai (snapshot me ek dafa), history recoverable.
# NOTE: ab zip tracked NAHI → tree se delete kiya to git se recover NAHI hoga.
# release/archive/ ki "≥3 releases mehfooz" rule ab tree par lagti hai.
release/*.zip
release/archive/*.zip
